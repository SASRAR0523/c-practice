// In this example, we demonstrate how to declare a variable, assign a value, and print it in C. 
// This method provides a simple way to store and display numerical values dynamically using basic syntax.

// When executed, the code will show:

// output:- Student Marks: 87

#include <stdio.h>

int main(){
    int marks = 87;

    printf("Student Marks: %d\n",marks);

    return 0;

}

