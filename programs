// Write a program to calculate the total calories consumed in a day through three meals. Then subtract the calories burned during exercise to find the net calorie intake.
// Use the addition (+) and subtraction (-) operators, and display all values clearly.
// Expected Output:

// Total Calories Consumed: 1450
// Calories Burned: 400
// Net Calorie Intake: 1050

#include <stdio.h>

int main() {
    int breakfast = 500;
    int lunch = 600;
    int dinner = 350;
    int caloriesBurned = 400;

    int totalCalories = breakfast + lunch + dinner;
    int netCalories = totalCalories - caloriesBurned;

    printf("Total Calories Consumed: %d\n", totalCalories);
    printf("Calories Burned: %d\n", caloriesBurned);
    printf("Net Calorie Intake: %d\n", netCalories);

    return 0;
}

